# Copie este arquivo para .env e preencha com seus dados reais

# Supabase — PostgreSQL
# Encontrado em: supabase.com → seu projeto → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_REF.supabase.co:5432/postgres

# Segredo JWT para tokens (gere um aleatório: openssl rand -hex 32)
SECRET_KEY=troque_por_uma_chave_secreta_longa

# Ambiente
ENVIRONMENT=production

# URL do frontend (para CORS)
# Vercel: será algo como https://cotacad.vercel.app
FRONTEND_URL=https://SEU_DOMINIO.vercel.app

# Tamanho máximo de upload em MB
MAX_UPLOAD_MB=50
